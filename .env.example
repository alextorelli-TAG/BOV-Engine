# TAG BOV Engine — environment template.
# Copy this file to `.env` and fill in real values. `.env` is gitignored and MUST
# NEVER be committed. Keys are read only by the build server (serve/app.py) — they
# never reach the browser or the config JSON.
#
# RECOMMENDED: keep the real .env OUTSIDE the repo so it can't be committed, and
# point the server at it:  set BOV_ENV_FILE="C:/path/to/.env" before launching
# uvicorn. Otherwise the server reads a .env at the repo root.

# --- Google Maps Platform (comps map rendering) ---
# One key, restricted in Google Cloud to the Geocoding API + Maps Static API.
# The server accepts either GMAPS_PLATFORM_API_KEY or GOOGLE_MAPS_API_KEY.
GMAPS_PLATFORM_API_KEY=your-google-maps-key-here
# Optional, for Static Maps URL signing (deferred — leave blank for now):
GOOGLE_MAPS_URL_SIGNING_SECRET=

# --- Anthropic (copy generation — ROADMAP Part D, not yet wired) ---
ANTHROPIC_API_KEY=your-anthropic-key-here

# --- US Census (demographics — future market-overview slides) ---
CENSUS_API_KEY=
CENSUS_API_USER=

# --- Optional: where operator-supplied images resolve (Photos uploads) ---
# BOV_LIBRARY_ROOT=C:/path/to/your/image/folder
