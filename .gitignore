# --- Proprietary / large corporate source — keep local, regenerate on demand ---
# The corporate InDesign package (PDF + IDML + INDD + Getty-licensed Links).
YE 2025 BOV Template*/
# The 53 single-page PDFs split from the corporate master (~79 MB).
page_library/
# Any loose corporate/deal PDFs and design sources.
*.pdf
*.idml
*.indd
*.psd
*.eps

# --- Committed licensed media (internal-only, private repo) ---
# The one deliberate home for licensed Getty/brand/stock imagery. This tool is
# never public, so these are checked in for point-and-click selection. Kept as an
# explicit exception in case a broad image ignore is ever added above.
!assemble/assets/stock/
!assemble/assets/stock/**

# --- Secrets — NEVER commit ---
# API keys (Google Maps, Anthropic) live here, loaded server-side only.
.env
.env.*
!.env.example

# --- Server cache (geocoded coords + rendered map PNGs) ---
serve/.cache/

# --- Local agent / editor state ---
.claude/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# --- Build output / scratch ---
*.raw
/out.pdf
/build/
